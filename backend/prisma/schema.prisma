// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int        @id @default(autoincrement())
  username   String     @unique
  password   String
  occupation Occupation @default(citizen)
  powerLevel Int        @default(0) @map("power_level")

  @@map("user")
}

model FeatureFlag {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  rules     Rule[]
  isEnabled Boolean @default(false) @map("is_enabled")

  @@map("feature_flag")
}

model Rule {
  id        Int           @id @default(autoincrement())
  attribute UserAttribute
  value     String
  operator  Operator
  flagId    Int
  flag      FeatureFlag   @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([value, flagId, operator])
  @@map("rule")
}

enum Operator {
  startsWith  @map("starts_with")
  endsWith    @map("ends_at")
  equal
  notEqual    @map("not_equal")
  lessThan    @map("less_than")
  greaterThan @map("greater_than")

  @@map("operator")
}

enum Occupation {
  citizen
  pirate
  marine
  bountyHunter @map("bounty_hunter")
  admin

  @@map("occupation")
}

enum UserAttribute {
  id
  username
  occupation
  powerLevel @map("power_level")

  @@map("user_attribute")
}
